{
    "version": "0.7.0",
    "description": "A fast application launcher for Windows with hotkey support, Start Menu discovery, and custom commands",
    "homepage": "https://github.com/gicrisf/windmenu",
    "license": "GPL-3.0-only",
    "url": "https://github.com/gicrisf/windmenu/releases/download/v0.7.0/windmenu.zip",
    "hash": "6f4f523c9ce341bebfc891a28c688c71baa968f4d226e2a1fcacf845879ffde2",
    "bin": "windmenu.exe",
    "persist": "windmenu.toml",
    "post_install": [
        "& powershell -NoProfile -ExecutionPolicy Bypass -File \"$dir\\autostart.ps1\" enable -ExePath \"$dir\\windmenu.exe\""
    ],
    "pre_uninstall": [
        "windmenu stop",
        "& powershell -NoProfile -ExecutionPolicy Bypass -File \"$dir\\autostart.ps1\" disable"
    ],
    "notes": [
        "To get started, run:",
        "  windmenu start",
        "",
        "Then press Ctrl+Alt+Space to launch the menu.",
        "",
        "windmenu is set to auto-start on login (a shortcut in your Startup folder).",
        "Remove that shortcut to disable it; it is cleaned up automatically on uninstall."
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/gicrisf/windmenu/releases/download/v$version/windmenu.zip"
    }
}
